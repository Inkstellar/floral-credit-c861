  "stages": {
    "1": {
      "icon": "🎨",
      "title": "Figma Tokens",
      "role": "Ingestion Layer",
      "overview": "The orchestration begins by bridging the gap between design files and raw data. By treating design as code, we eliminate the 'handover' process entirely.",
      "logic": ["Webhook", "Validation", "Normalizer", "JSON"],
      "steps": [
        { "h": "Event Trigger", "p": "Listens for the library_publish event from Figma, triggering an instant sync across the pipeline." },
        { "h": "Token Extraction", "p": "Recursively crawls variable collections, resolving aliases to find the concrete primitive values." },
        { "h": "Governance Guard", "p": "Validates tokens against regex naming rules to ensure consistency before ingestion." }
      ],
      "code": {
        "file": "ingest.ts",
        "lines": [
          "// Extract and normalize tokens",
          "const tokens = await figma.getVariables(fileKey);",
          "const normalized = tokens.map(t => ({",
          "  name: t.name,",
          "  value: resolveAlias(t.value),",
          "  type: t.type,",
          "}));",
          "if (validate(normalized)) return normalized;"
        ]
      },
      "metrics": [{ "v": "142", "l": "Tokens" }, { "v": "0.4s", "l": "Parsing" }, { "v": "100%", "l": "Integrity" }],
      "io": { "in": ["Figma API Key", "File ID"], "out": ["tokens.json"] },
      "impact": "Removes manual export steps, saving an average of 4 hours per design sprint.",
      "tech": ["Node.js", "Figma REST API", "Zod Validation"]
    },
    "2": {
      "icon": "⚙️",
      "title": "Style Dictionary",
      "role": "Transformation",
      "overview": "Design tokens are abstract. This stage applies platform-specific logic to transform that abstraction into usable code for every target environment.",
      "logic": ["JSON", "Transform", "Compile", "Artifacts"],
      "steps": [
        { "h": "Platform Mapping", "p": "Maps a single 'color.brand.primary' to CSS var, XML resource, and Swift property." },
        { "h": "Unit Conversion", "p": "Calculates spacing and sizing based on platform density (e.g., rem to dp)." },
        { "h": "Format Emission", "p": "Writes files to the distribution folder, ready for version control." }
      ],
      "code": {
        "file": "sd.config.js",
        "lines": [
          "module.exports = {",
          "  platforms: {",
          "    web: { transformGroup: \"css\", format: \"css/vars\" },",
          "    ios: { transformGroup: \"ios\", format: \"ios/swift\" },",
          "    android: { transformGroup: \"android\", format: \"android/xml\" },",
          "  }",
          "};"
        ]
      },
      "metrics": [{ "v": "3", "l": "Platforms" }, { "v": "1.2s", "l": "Build" }, { "v": "0", "l": "Drift" }],
      "io": { "in": ["tokens.json"], "out": ["vars.css", "colors.xml", "tokens.swift"] },
      "impact": "Ensures a 'Pixel Perfect' match across Web, iOS, and Android without manual recalculation.",
      "tech": ["Style Dictionary", "JavaScript", "JSON-Schema"]
    },
    "3": {
      "icon": "🐙",
      "title": "GitHub",
      "role": "Version Control",
      "overview": "Changes are treated as code. By routing tokens through GitHub, we apply the same rigor to design changes as we do to feature code.",
      "logic": ["Commit", "PR", "CI Test", "Merge"],
      "steps": [
        { "h": "Automated Commit", "p": "Creates a commit of the generated artifacts on a dedicated sync branch." },
        { "h": "Visual Regression", "p": "Triggers CI to render a 'shadow' site and compare pixels against the current production baseline." },
        { "h": "Audit Trail", "p": "Merges the PR only after approval, providing a permanent record of every design change." }
      ],
      "code": {
        "file": "sync.yml",
        "lines": [
          "on: [repository_dispatch]",
          "jobs:",
          "  test:",
          "    steps:",
          "      - run: npx visual-diff check",
          "      - uses: actions/merge-pr@v1",
          "        with: { force: true }"
        ]
      },
      "metrics": [{ "v": "#442", "l": "PRs" }, { "v": "0", "l": "Regressions" }, { "v": "42s", "l": "CI Time" }],
      "io": { "in": ["Build Artifacts"], "out": ["Main Branch Update", "CI Report"] },
      "impact": "Eliminates the 'breaking change' risk when design tokens are updated in production.",
      "tech": ["GitHub Actions", "Visual Regression", "GitOps"]
    },
    "4": {
      "icon": "🚀",
      "title": "Production",
      "role": "Deployment",
      "overview": "The final mile. Tokens are deployed to a global edge network, allowing the UI to update in real-time without a full application redeploy.",
      "logic": ["Deploy", "Canary", "Purge", "Sync"],
      "steps": [
        { "h": "Edge Push", "p": "Pushes the immutable token package to the global CDN distribution." },
        { "h": "Canary Rollout", "p": "Routes 10% of traffic to the new tokens to monitor for layout breakage." },
        { "h": "Global Sync", "p": "Purges the CDN cache globally, updating the theme for all users in milliseconds." }
      ],
      "code": {
        "file": "deploy.ts",
        "lines": [
          "await cdn.deploy({",
          "  package: \"@ds/tokens@latest\",",
          "  strategy: \"canary\",",
          "  regions: [\"US-East\", \"EU-West\", \"AP-South\"],",
          "  purge: true",
          "});"
        ]
      },
      "metrics": [{ "v": "18", "l": "Regions" }, { "v": "1.1s", "l": "Propagation" }, { "v": "99.9%", "l": "Uptime" }],
      "io": { "in": ["Merged Package"], "out": ["Live CDN Assets"] },
      "impact": "Allows instant theme updates (e.g., seasonal colors) without shipping a new app version.",
      "tech": ["AWS CloudFront", "Edge Computing", "Canary Deployment"]
    }
  }
